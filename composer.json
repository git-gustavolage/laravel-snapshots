{
    "name": "lageg/checkpoint",
    "description": "",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "lageg"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.11",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Lageg\\Checkpoint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lageg\\Checkpoint\\CheckpointServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
